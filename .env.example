# ---------------------------------------------------------------------------
# Supabase
# Cria um projeto em https://supabase.com, corre as migrações em
# supabase/migrations (ver README) e copia estas chaves em Project Settings > API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Só é usada em scripts server-side pontuais (nunca exposta ao browser).
# Não é necessária para o funcionamento normal do site (admin/cliente usam RLS).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Resend (envio de emails de confirmação)
# Cria uma conta em https://resend.com e gera uma API key.
# Em desenvolvimento podes deixar em branco: os emails ficam só registados na consola.
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL="Nails Von <onboarding@resend.dev>"
ADMIN_NOTIFICATION_EMAIL=geral@nailsvon.pt

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# URL pública do site (usada em SEO, sitemap, robots, JSON-LD). Em produção,
# usar o domínio real (ex.: https://nailsvon.pt).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
